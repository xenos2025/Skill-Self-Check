# OS
.DS_Store
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment and secrets — never commit
.env
.env.*
*.key
*.pem
credentials.json
**/token*.json
**/client_secret*.json

# MCP configs that may carry credentials
.mcp.json
.mcp.local.json
**/.mcp.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local scratch / generated reports at repo root
/outputs/
/_scratch*/
*.log

# Archives
*.zip
*.tar.gz
*.rar

# Keep exp work local-only if someone dumps client PII there
exp/**/private/
exp/**/*.csv
!exp/**/*.example.csv
!exp/**/assets/templates/*.csv
